# Salin ke .env lalu ganti nilainya:  cp .env.example .env
# .env TIDAK boleh di-commit (sudah ada di .gitignore).

LOG_LEVEL=INFO

# ---- Port yang di-publish ke host (default sesuai spesifikasi) ----
API_PORT=8080
BMKG_PORT=8081
PVMBG_PORT=8082
AUTH_PORT=8090

# ---- BMKG mock (header X-BMKG-Key) ----
BMKG_API_KEY=bmkg-key-change-me
BMKG_RESPONSE_DELAY_MS=100
BMKG_NEW_EVENT_INTERVAL_SECONDS=10

# ---- PVMBG mock (header Authorization: Bearer <token>) ----
# Format berbeda dari BMKG secara sengaja; kredensial tidak saling berlaku.
PVMBG_TOKEN=pvmbg.v1.change-me
PVMBG_RESPONSE_DELAY_MIN_MS=500
PVMBG_RESPONSE_DELAY_MAX_MS=3000
PVMBG_NEW_EVENT_INTERVAL_SECONDS=10

# ---- BNPB Aggregator ----
POLL_INTERVAL_SECONDS=3
# Timeout panggilan ke BMKG/PVMBG; harus > delay PVMBG (maks 3000 ms).
UPSTREAM_TIMEOUT_MS=5000
# Sumber tanpa poll sukses selama ini dianggap stale (P2: stale_since).
SOURCE_STALE_AFTER_SECONDS=15
SNAPSHOT_DEFAULT_LIMIT=200
SNAPSHOT_MAX_LIMIT=1000

# ---- BNPB Client-Facing API: perlindungan resource (P2), 0 = nonaktif ----
API_UPSTREAM_TIMEOUT_MS=2000
MAX_CONCURRENT_REQUESTS=128
# Token bucket per identitas client (JWT sub). 3 client x 300 rps = ~57% kapasitas terukur
RATE_LIMIT_RPS=300
RATE_LIMIT_BURST=600

# ---- Canonical Store (MongoDB, hanya diakses bnpb-aggregator) ----
MONGO_ROOT_USER=bnpb
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=bnpb

# ---- Kafka (P5) ----
KAFKA_HAZARD_TOPIC=hazard-events
KAFKA_TOPIC_PARTITIONS=3
# Retensi topic = berapa lama consumer boleh mati dan masih bisa menyusul event yang terlewat.
KAFKA_TOPIC_RETENTION_HOURS=168
# Relay outbox di aggregator: seberapa sering event pending dikirim ke Kafka, dan per batch berapa.
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# ---- Consumer (P5) ----
DASHBOARD_PORT=8091
NOTIFIER_PORT=8092
PEMDA_PORT=8093
# Jeda buatan per event untuk demo consumer lambat (0 = nonaktif)
DASHBOARD_PROCESSING_DELAY_MS=0
NOTIFIER_PROCESSING_DELAY_MS=0

# ---- BNPB Auth / Token Service ----
JWT_SIGNING_KEY=change-me-to-a-long-random-string
JWT_ISSUER=bnpb-auth
JWT_AUDIENCE=bnpb-api
ACCESS_TOKEN_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=3600
JWKS_CACHE_TTL_SECONDS=300

# Tiga identitas client downstream yang benar-benar terpisah
CLIENT_MEDIA_ID=media
CLIENT_MEDIA_SECRET=media-secret-change-me
CLIENT_FIELD_ID=field-team
CLIENT_FIELD_SECRET=field-secret-change-me
CLIENT_OPS_ID=bnpb-ops
CLIENT_OPS_SECRET=ops-secret-change-me
